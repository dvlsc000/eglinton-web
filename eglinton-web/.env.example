# ---------------------------------------------------------------------------
# The Eglinton website — environment configuration
# Copy to .env.local for development. Never commit real keys.
# ---------------------------------------------------------------------------

# Data source: "mock" (demonstration data, default) or "api" (real backend).
# In mock mode the site shows a "Design proposal" notice and is not indexed.
NEXT_PUBLIC_DATA_MODE=mock

# Public base URL, used for metadata, calendar links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- API mode only ---------------------------------------------------------
# Base URL of the club's tournament/league API (no trailing slash).
CASINO_API_URL=
# Optional bearer token, sent as "Authorization: Bearer <key>". Server-side only.
CASINO_API_KEY=
# How long (seconds) Next.js may cache API responses. 0 = always fresh.
CASINO_API_REVALIDATE_SECONDS=60
# Request timeout in milliseconds.
CASINO_API_TIMEOUT_MS=8000

# --- Development only ------------------------------------------------------
# Artificial latency for the mock provider, to review loading states.
MOCK_LATENCY_MS=0
